", "template_override": 1}, {"id": 3, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "Select all the sentences that ask for an opinion.", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "I knew we could do it!", "type": "text"}], "correct": false}, {"text": "", "id": 1, "selected": 0, "_data": [{"content": "How do you want to celebrate this? ", "type": "text"}], "correct": true}, {"text": "", "id": 2, "selected": 0, "_data": [{"content": "How about you?", "type": "text"}], "correct": true}, {"text": "", "id": 3, "selected": 0, "_data": [{"content": "How do you feel about including some chocolate?", "type": "text"}], "correct": true}, {"text": "", "id": 4, "selected": 0, "_data": [{"content": "I could sense Farmani was leaning our way.", "type": "text"}], "correct": false}, {"text": "", "id": 5, "selected": 0, "_data": [{"content": "I think you really persuaded him.", "type": "text"}], "correct": false}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "Select all the sentences that give an opinion.", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "You weren't taken by surprise, were you?", "type": "text"}], "correct": false}, {"text": "", "id": 1, "selected": 0, "_data": [{"content": "We haven't thought about that yet. ", "type": "text"}], "correct": false}, {"text": "", "id": 2, "selected": 0, "_data": [{"content": "Should I look into a caterer?", "type": "text"}], "correct": false}, {"text": "", "id": 3, "selected": 0, "_data": [{"content": "I felt that as soon as he gave us the extension. ", "type": "text"}], "correct": true}, {"text": "", "id": 4, "selected": 0, "_data": [{"content": "That was a strong indication, if you ask me.", "type": "text"}], "correct": true}, {"text": "", "id": 5, "selected": 0, "_data": [{"content": "I must say I like the idea.", "type": "text"}], "correct": true}, {"text": "", "id": 6, "selected": 0, "_data": [{"content": "Of course!", "type": "text"}], "correct": false}, {"text": "", "id": 7, "selected": 0, "_data": [{"content": "To be honest, you're good at that.", "type": "text"}], "correct": true}, {"text": "", "id": 8, "selected": 0, "_data": [{"content": "I could be wrong, but we have some employees on a high protein diet, so we need meat as well. ", "type": "text"}], "correct": true}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 2}], "_data": [{"type": "instructions", "contents": [{"content": " \nDoes Janet think Farmani was <span class=\"tool-tip\" id=\"tip_3_0\">leaning their way</span>?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"content": [{"content": "To <span class=\"italic\">\"lean your way\"</span> means someone is interested in something you have proposed.", "type": "text", "tip_id": 0}], "type": "tips"}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">Select all the correct answers.<span class=\"bullet\">Record yourself saying the sentences aloud. <span class=\"bullet\">Check your pronunciation with your instructor. ", "type": "text"}, {"content": " You have 2 attempts to submit your answers.", "type": "text"}]}],